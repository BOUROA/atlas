# FlipyERP Academy · variables de entorno de producción.
# Copiar a /opt/academy/academy.env (propietario root, grupo academy, modo 640).

# Conexión a PostgreSQL por socket local con autenticación "peer": el usuario
# del sistema `academy` entra como el rol `academy` sin contraseña. No hay
# ningún secreto que guardar ni que pueda filtrarse.
DATABASE_URL=postgresql:///academy?host=/var/run/postgresql

# Enlaces de invitación y cookies seguras (solo HTTPS).
ACADEMY_PUBLIC_URL=https://academy.flipyerp.com
ACADEMY_SECURE_COOKIES=1

# Escucha solo en local; nginx hace de proxy.
ATLAS_HOST=127.0.0.1

NODE_ENV=production
